{
	"name": "usegonche",
	"private": true,
	"author": {
		"name": "Sebastian Marat Urdanegui Bisalaya",
		"url": "https://www.sebastianurdanegui.com/"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @usegonche/database generate && node scripts/build.mjs",
		"deploy:worker": "wrangler deploy",
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"dev:worker": "wrangler dev",
		"format": "biome format --write",
		"lint": "biome check",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" typecheck"
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"@usegonche/auth": "workspace:*",
		"@usegonche/database": "workspace:*",
		"@usegonche/storage": "workspace:*",
		"hono": "4.13.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "26.1.1",
		"esbuild": "0.28.2",
		"tsx": "4.23.0",
		"typescript": "7.0.2",
		"wrangler": "4.156.0"
	},
	"packageManager": "pnpm@12.3.4"
}
