{
	"name": "usegonche",
	"private": true,
	"author": {
		"name": "Sebastian Marat Urdanegui Bisalaya",
		"url": "https://www.sebastianurdanegui.com/"
	},
	"type": "module",
	"scripts": {
		"build": "pnpm --filter @usegonche/database generate && node scripts/build.mjs",
		"deploy:worker": "wrangler deploy",
		"dev": "tsx watch --env-file-if-exists=.env src/index.ts",
		"dev:worker": "wrangler dev",
		"format": "biome format --write",
		"lint": "biome check",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" typecheck"
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"@hono/zod-validator": "0.9.1",
		"@usegonche/auth": "workspace:*",
		"@usegonche/database": "workspace:*",
		"@usegonche/storage": "workspace:*",
		"hono": "4.13.16",
		"hono-rate-limiter": "0.5.4",
		"rrule": "2.8.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "5.0.5",
		"esbuild": "0.28.2",
		"tsx": "4.23.0",
		"typescript": "7.0.2",
		"vitest": "5.0.5",
		"wrangler": "4.156.0"
	},
	"packageManager": "pnpm@12.3.4"
}
