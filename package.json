{
	"name": "usegonche",
	"private": true,
	"author": {
		"name": "Sebastian Marat Urdanegui Bisalaya",
		"url": "https://www.sebastianurdanegui.com/"
	},
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx watch src/index.ts",
		"format": "biome format --write",
		"lint": "biome check",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"postinstall": "prisma skills sync || exit 0"
	},
	"dependencies": {
		"@hono/node-server": "2.1.3",
		"@prisma/extension-accelerate": "3.0.1",
		"@supabase/ssr": "0.12.7",
		"@supabase/supabase-js": "2.118.0",
		"hono": "4.13.16"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@types/node": "26.1.1",
		"prisma": "8.0.0-rc.29",
		"tsx": "4.23.0",
		"typescript": "7.0.2"
	},
	"packageManager": "pnpm@12.3.4"
}
