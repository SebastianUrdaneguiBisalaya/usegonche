{
	"compilerOptions": {
		"allowJs": true,
		"incremental": true,
		"jsx": "react-jsx",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		},
		"plugins": [{ "name": "next" }]
	},
	"exclude": ["node_modules"],
	"extends": "../../tsconfig.base.json",
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts", "**/*.mts"]
}
