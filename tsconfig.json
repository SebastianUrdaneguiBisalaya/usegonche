{
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"noEmit": false,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": ["node"]
	},
	"exclude": ["node_modules", "dist"],
	"extends": "./tsconfig.base.json",
	"include": ["src"]
}
