# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed by @usegonche/auth/admin (bypasses RLS). Never expose to web/mobile.
SUPABASE_SECRET_KEY=

# Prisma / Postgres (Supabase > Connect)
# Runtime: pooled connection (Supavisor transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: direct or session-pooler connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Node / Docker only
PORT=3000

# Auth redirects (packages/auth)
# Where the browser lands after Google sign-in / email confirmation.
AUTH_REDIRECT_URL=http://localhost:5173
# Optional: public URL of GET /auth/callback (set it when behind a proxy / on Workers custom domains).
AUTH_CALLBACK_URL=http://localhost:3000/auth/callback
