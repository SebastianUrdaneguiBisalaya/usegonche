# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Server only. Needed by @usegonche/auth/admin (bypasses RLS). Never expose to web/mobile.
SUPABASE_SECRET_KEY=

# Prisma / Postgres (Supabase > Connect)
# Runtime: pooled connection (Supavisor transaction mode, port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Migrations: direct or session-pooler connection (port 5432).
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Node / Docker only
PORT=3000

# Auth redirects (packages/auth)
# Where the browser lands after Google sign-in / email confirmation.
AUTH_REDIRECT_URL=http://localhost:5173
# Browser origins allowed by CORS: the origin of AUTH_REDIRECT_URL is always allowed; add more here, comma separated (optional).
CORS_ORIGINS=
# Cookie domain of the session, only when the web app and the API are on different subdomains (e.g. .example.com). Leave empty locally.
COOKIE_DOMAIN=
# Optional: public URL of GET /v1/auth/callback (set it when behind a proxy / on Workers custom domains).
AUTH_CALLBACK_URL=http://localhost:4000/v1/auth/callback
# Optional: where Supabase sends the mobile app back after Google sign-in (/v1/auth/native/google). Default usegonche://auth/callback.
# It must be listed in Supabase -> Authentication -> URL Configuration -> Redirect URLs.
NATIVE_AUTH_REDIRECT_URL=

# Supabase Storage buckets (optional; defaults shown). Create both in Supabase > Storage.
# Files go straight from the clients to Storage with signed URLs; attachments use the private bucket.
STORAGE_BUCKET_PRIVATE=private
STORAGE_BUCKET_PUBLIC=public

# Rate limiting (requests per minute; see src/middleware/rate-limit.ts). Node uses in-memory counters per process.
# On Workers the Cloudflare Rate Limiting bindings in wrangler.jsonc are used instead and these are ignored.
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_PER_MINUTE=120
# Strict limit for /auth/* (login, signup, password reset, code checks).
RATE_LIMIT_AUTH_PER_MINUTE=10
# Set to true ONLY behind a reverse proxy you control that sets X-Forwarded-For; otherwise clients could forge their IP.
TRUST_PROXY=false

# Internal endpoints called by the Supabase pg_cron job (POST /v1/internal/reminders/process, header x-internal-secret).
# Generate a long random value (e.g. `openssl rand -hex 32`); use the same value in packages/database/prisma/manual/reminders-pg-cron.sql.
# On Workers: `wrangler secret put INTERNAL_CRON_SECRET`. Unset = the endpoint answers 401 to everyone.
INTERNAL_CRON_SECRET=

# Google code exchange (POST /v1/auth/google): web popup client and the "Desktop app" client used by apps/desktop
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# Droplet / docker-compose.yml only: public domain Caddy serves the API on (A record -> droplet). Set AUTH_CALLBACK_URL=https://<API_DOMAIN>/v1/auth/callback and TRUST_PROXY is forced to true by compose.
API_DOMAIN=
