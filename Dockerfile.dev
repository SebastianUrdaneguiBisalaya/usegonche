# syntax=docker/dockerfile:1
# Development image: installs dependencies and runs `pnpm dev` (tsx watch). docker-compose.dev.yml bind-mounts the
# source over /app, so edits on the host reload the server; node_modules live in volumes instead of the host.
FROM node:22-slim
RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile --filter "usegonche..."
ENV PORT=3000
EXPOSE 3000
CMD ["pnpm", "dev"]
