generator client {
  provider   = "prisma-client"
  output     = "../src/generated/node"
  engineType = "client"
  runtime    = "nodejs"
}

// Same models, compiled for Cloudflare Workers (wasm module import instead of base64).
generator client_workerd {
  provider   = "prisma-client"
  output     = "../src/generated/workerd"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider = "postgresql"
}

// Conventions (see AGENTS.md > Database & migrations):
// - Ids are UUID v4: `@db.Uuid @default(uuid(4))`. Only `Profile.id` is supplied by Supabase (mirrors `auth.users.id`).
// - Every user-owned table has `ownerId` (column `owner_id`) -> `Profile.id`.
// - No Json columns. Rich text is stored as `text`.
// - Timestamps are `timestamptz`.

/// App-level profile and the owner of every resource. The identity itself lives in
/// Supabase `auth.users`; `id` mirrors `auth.users.id` (also a UUID v4).
model Profile {
  id          String   @id @db.Uuid
  email       String?  @db.VarChar(255)
  avatarUrl   String?  @map("avatar_url")
  displayName String?  @map("display_name") @db.VarChar(100)
  phoneNumber String?  @map("phone_number") @db.VarChar(100)
  websiteUrl  String?  @map("website_url") @db.VarChar(255)
  bio         String?  @db.Text
  jobTitle    String?  @map("job_title") @db.VarChar(100)
  industry    String?  @db.VarChar(100)
  company     String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings            UserSettings?
  tags                Tag[]
  inboxItems          InboxItem[]
  goals               Goal[]
  projects            Project[]
  tasks               Task[]
  taskBlockers        TaskBlocker[]
  notes               Note[]
  attachments         Attachment[]
  availabilityWindows AvailabilityWindow[]
  calendarEvents      CalendarEvent[]
  dailyPlans          DailyPlan[]
  dailyPlanItems      DailyPlanItem[]
  timeBlocks          TimeBlock[]
  taskEvents          TaskEvent[]
  reviews             Review[]
  reviewDecisions     ReviewDecision[]
  recurrenceRules     RecurrenceRule[]
  noteRevisions       NoteRevision[]
  templates           Template[]
  templateItems       TemplateItem[]
  reminders           Reminder[]

  @@map("profiles")
}

/// One row per profile (1:1).
model UserSettings {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  language  String?  @db.VarChar(10)
  theme     String?  @db.VarChar(10)
  /// IANA time zone name, e.g. `America/Lima`.
  timezone  String?  @db.VarChar(64)
  country   String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Owner-scoped label. Names are unique per owner ignoring case via a manual-SQL index on `(owner_id, lower(name))`
/// (see the add_tags migration); `@@unique` below only models the exact-match part.
/// Links to tasks, projects and notes use typed join tables (added with those features),
/// with `onDelete: Cascade` on the tag side so deleting a tag removes its links, never the targets.
model Tag {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects        ProjectTag[]
  tasks           TaskTag[]
  notes           NoteTag[]
  recurrenceRules RecurrenceRuleTag[]
  templates       TemplateTag[]
  templateItems   TemplateItemTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

/// Where a captured item came from. Extend (share, integration, ...) when those sources exist.
enum InboxSource {
  quick
  braindump

  @@map("inbox_source")
}

/// `converted` is terminal: the item was turned into a task, project or note (the target keeps `origin_inbox_item_id`).
enum InboxStatus {
  pending
  converted
  archived
  discarded

  @@map("inbox_status")
}

/// Raw capture, never deleted: it is only converted, archived or discarded, so nothing is lost while classifying.
model InboxItem {
  id          String      @id @default(uuid(4)) @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  content     String      @db.Text
  source      InboxSource @default(quick)
  status      InboxStatus @default(pending)
  capturedAt  DateTime    @default(now()) @map("captured_at") @db.Timestamptz(6)
  /// Set when the item leaves `pending`; null again when restored.
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks    Task[]
  notes    Note[]

  @@index([ownerId, status, capturedAt])
  @@map("inbox_items")
}

enum GoalStatus {
  active
  achieved

  @@map("goal_status")
}

/// Lifecycle status only. Being archived is separate (`archivedAt`), so an achieved goal can be archived and an archived one restored.
enum ProjectStatus {
  active
  on_hold
  completed

  @@map("project_status")
}

/// Outcome the user wants to reach; groups projects (1:N). Never deleted, only archived.
/// `description` is serialized TipTap JSON (opaque text, validated and bounded by the API).
model Goal {
  id          String     @id @default(uuid(4)) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String?    @db.Text
  status      GoalStatus @default(active)
  targetDate  DateTime?  @map("target_date") @db.Date
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects        Project[]
  tasks           Task[]
  recurrenceRules RecurrenceRule[]

  @@index([ownerId, archivedAt, createdAt])
  @@map("goals")
}

/// Container of tasks, optionally under a goal. Archiving it keeps its tasks. Never deleted, only archived.
/// `originInboxItemId` is set when it was created by converting an inbox item (an item converts at most once).
model Project {
  id                String        @id @default(uuid(4)) @db.Uuid
  ownerId           String        @map("owner_id") @db.Uuid
  goalId            String?       @map("goal_id") @db.Uuid
  originInboxItemId String?       @unique @map("origin_inbox_item_id") @db.Uuid
  title             String        @db.VarChar(200)
  description       String?       @db.Text
  status            ProjectStatus @default(active)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  originInboxItem InboxItem?       @relation(fields: [originInboxItemId], references: [id], onDelete: SetNull)
  tags            ProjectTag[]
  tasks           Task[]
  recurrenceRules RecurrenceRule[]
  notes           Note[]
  attachments     Attachment[]
  eventsFrom      TaskEvent[]      @relation("TaskEventFromProject")
  eventsTo        TaskEvent[]      @relation("TaskEventToProject")

  @@index([ownerId, archivedAt, createdAt])
  @@index([goalId])
  @@map("projects")
}

/// Typed join project <-> tag. The owner is implied by the project (the service checks both belong to the same owner).
/// Deleting either side removes the link only.
model ProjectTag {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

/// How the task came to exist. Extend (integration, ai, ...) when those sources exist.
enum TaskOrigin {
  manual
  inbox
  template

  @@map("task_origin")
}

/// Unit of work. Keeps lifecycle concepts apart: `status`, `priority`, dates (`startDate`/`dueDate` are the user's own
/// deadlines, not planning), derived progress (from subtasks) and derived blocking (dependencies + open blockers) are never stored.
/// Planning (when to work on it) lives in the daily plan / time blocks, not here.
/// `completedAt` is set when the status becomes `done` and cleared when reopened. Subtasks are single level (`parentId`).
/// `description` is serialized TipTap JSON (opaque text).
model Task {
  id                String       @id @default(uuid(4)) @db.Uuid
  ownerId           String       @map("owner_id") @db.Uuid
  parentId          String?      @map("parent_id") @db.Uuid
  projectId         String?      @map("project_id") @db.Uuid
  goalId            String?      @map("goal_id") @db.Uuid
  originInboxItemId String?      @unique @map("origin_inbox_item_id") @db.Uuid
  /// Set when this task is an occurrence of a recurrence rule; `occurrenceDate` is the day the rule produced it (unique per rule).
  recurrenceId      String?      @map("recurrence_id") @db.Uuid
  occurrenceDate    DateTime?    @map("occurrence_date") @db.Date
  title             String       @db.VarChar(200)
  description       String?      @db.Text
  status            TaskStatus   @default(todo)
  priority          TaskPriority @default(medium)
  origin            TaskOrigin   @default(manual)
  startDate         DateTime?    @map("start_date") @db.Date
  dueDate           DateTime?    @map("due_date") @db.Date
  estimatedMinutes  Int?         @map("estimated_minutes")
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent          Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]           @relation("Subtasks")
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  originInboxItem InboxItem?       @relation(fields: [originInboxItemId], references: [id], onDelete: SetNull)
  recurrence      RecurrenceRule?  @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  tags            TaskTag[]
  /// Tasks this one waits for.
  dependencies    TaskDependency[] @relation("Dependent")
  /// Tasks waiting for this one.
  dependents      TaskDependency[] @relation("Dependency")
  blockers        TaskBlocker[]
  notes           TaskNote[]
  attachments     Attachment[]
  planItems       DailyPlanItem[]
  timeBlocks      TimeBlock[]
  events          TaskEvent[]
  reviewDecisions ReviewDecision[]
  reminders       Reminder[]

  @@unique([recurrenceId, occurrenceDate])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, dueDate])
  @@index([parentId])
  @@index([projectId])
  @@index([goalId])
  @@map("tasks")
}

/// `taskId` waits for `dependsOnId`. No self-dependency (CHECK in the migration) and no cycles (checked by the service).
/// The owner is implied by the tasks (the service checks both belong to the same owner).
model TaskDependency {
  taskId      String @map("task_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  task      Task @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("Dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

/// Manual impediment with a reason. Kept after it is resolved (`resolvedAt`) so recurring blockers can be analyzed.
model TaskBlocker {
  id         String    @id @default(uuid(4)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  reason     String    @db.VarChar(500)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task  Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, resolvedAt])
  @@index([ownerId, startedAt])
  @@map("task_blockers")
}

/// Typed join task <-> tag. Deleting either side removes the link only.
model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

/// Free-form document (the only note entity, no separate "document"). `body` is serialized TipTap JSON (opaque text,
/// validated and bounded by the API, never queried). Deleting a project keeps its notes (unlinks them); notes are deleted explicitly.
model Note {
  id                String   @id @default(uuid(4)) @db.Uuid
  ownerId           String   @map("owner_id") @db.Uuid
  projectId         String?  @map("project_id") @db.Uuid
  originInboxItemId String?  @unique @map("origin_inbox_item_id") @db.Uuid
  title             String   @db.VarChar(200)
  body              String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  originInboxItem InboxItem?     @relation(fields: [originInboxItemId], references: [id], onDelete: SetNull)
  tags            NoteTag[]
  tasks           TaskNote[]
  attachments     Attachment[]
  revisions       NoteRevision[]
  reminders       Reminder[]

  @@index([ownerId, createdAt])
  @@index([projectId])
  @@map("notes")
}

/// Typed join note <-> tag. Deleting either side removes the link only.
model NoteTag {
  noteId String @map("note_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

/// N:M link task <-> note. The owner is implied by both sides (the service checks they belong to the same owner).
model TaskNote {
  taskId String @map("task_id") @db.Uuid
  noteId String @map("note_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([taskId, noteId])
  @@index([noteId])
  @@map("task_notes")
}

/// Metadata of a file stored in Supabase Storage (the bytes never touch the API or the database).
/// Belongs to exactly one of task / project / note (CHECK in the migration). `storagePath` is `<ownerId>/<uuid>/file`.
model Attachment {
  id          String   @id @default(uuid(4)) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  taskId      String?  @map("task_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  noteId      String?  @map("note_id") @db.Uuid
  storagePath String   @unique @map("storage_path") @db.VarChar(300)
  name        String   @db.VarChar(255)
  mimeType    String   @map("mime_type") @db.VarChar(127)
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner   Profile  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([noteId, createdAt])
  @@index([ownerId, createdAt])
  @@map("attachments")
}

enum CalendarEventKind {
  event
  out_of_office

  @@map("calendar_event_kind")
}

enum TimeBlockStatus {
  planned
  done
  missed
  interrupted
  rescheduled

  @@map("time_block_status")
}

/// Weekly working hours: one row per window (a weekday can have several). Minutes are local wall-clock minutes of the
/// day in the user's timezone (`user_settings.timezone`). `weekday` is ISO (1 = Monday ... 7 = Sunday). CHECKs in the migration.
model AvailabilityWindow {
  id          String   @id @default(uuid(4)) @db.Uuid
  ownerId     String   @map("owner_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, weekday])
  @@map("availability_windows")
}

/// Manually entered calendar entry (external calendars come later through integrations). Always stored as an instant range;
/// all-day events span the user's local day(s) at creation time. `out_of_office` removes availability; a timed `event` does too;
/// an all-day `event` is informational only.
model CalendarEvent {
  id        String            @id @default(uuid(4)) @db.Uuid
  ownerId   String            @map("owner_id") @db.Uuid
  title     String            @db.VarChar(200)
  kind      CalendarEventKind @default(event)
  allDay    Boolean           @default(false) @map("all_day")
  startsAt  DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime          @map("ends_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     Profile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([ownerId, startsAt])
  @@map("calendar_events")
}

/// The tasks chosen for one local date, in order. Created lazily when the first task is planned.
model DailyPlan {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items DailyPlanItem[]

  @@unique([ownerId, date])
  @@map("daily_plans")
}

model DailyPlanItem {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  taskId    String   @map("task_id") @db.Uuid
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  plan  DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  task  Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([planId, taskId])
  @@index([taskId])
  @@map("daily_plan_items")
}

/// A slice of time, not a task: a task can have zero or many blocks, and a block can have no task (then `title` is required).
/// Moving a block never edits it: a new `planned` block is created with `rescheduledFromId` pointing at the old one, which keeps
/// its planned range (and becomes `rescheduled` if it was still `planned`). Overlaps are warnings in the service, not constraints.
/// CHECKs in the migration: planned_end > planned_start, actual_end > actual_start, task or title present.
model TimeBlock {
  id                String          @id @default(uuid(4)) @db.Uuid
  ownerId           String          @map("owner_id") @db.Uuid
  taskId            String?         @map("task_id") @db.Uuid
  title             String?         @db.VarChar(200)
  plannedStart      DateTime        @map("planned_start") @db.Timestamptz(6)
  plannedEnd        DateTime        @map("planned_end") @db.Timestamptz(6)
  actualStart       DateTime?       @map("actual_start") @db.Timestamptz(6)
  actualEnd         DateTime?       @map("actual_end") @db.Timestamptz(6)
  status            TimeBlockStatus @default(planned)
  rescheduledFromId String?         @map("rescheduled_from_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task            Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rescheduledFrom TimeBlock?  @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   TimeBlock[] @relation("Reschedule")
  taskEvents      TaskEvent[]

  @@index([ownerId, plannedStart])
  @@index([taskId])
  @@index([rescheduledFromId])
  @@map("time_blocks")
}

enum TaskEventType {
  status_changed
  priority_changed
  due_changed
  project_changed
  rescheduled

  @@map("task_event_type")
}

/// Who caused the change. Only `user` is written today; the rest are reserved for automation, AI proposals the user accepted
/// and integrations, so history can tell them apart later.
enum TaskEventActor {
  user
  system
  ai
  integration

  @@map("task_event_actor")
}

/// Functional history of a task: what changed and when, written by the services in the same transaction as the change.
/// One typed from/to column pair per event type (no generic payload); a CHECK in the migration enforces that each type fills exactly
/// its own columns. This is not an audit log. `rescheduled` records a time block of the task being moved (planned range from -> to).
model TaskEvent {
  id            String         @id @default(uuid(4)) @db.Uuid
  ownerId       String         @map("owner_id") @db.Uuid
  taskId        String         @map("task_id") @db.Uuid
  type          TaskEventType
  actor         TaskEventActor @default(user)
  occurredAt    DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(6)
  fromStatus    TaskStatus?    @map("from_status")
  toStatus      TaskStatus?    @map("to_status")
  fromPriority  TaskPriority?  @map("from_priority")
  toPriority    TaskPriority?  @map("to_priority")
  fromDueDate   DateTime?      @map("from_due_date") @db.Date
  toDueDate     DateTime?      @map("to_due_date") @db.Date
  fromProjectId String?        @map("from_project_id") @db.Uuid
  toProjectId   String?        @map("to_project_id") @db.Uuid
  fromStart     DateTime?      @map("from_start") @db.Timestamptz(6)
  fromEnd       DateTime?      @map("from_end") @db.Timestamptz(6)
  toStart       DateTime?      @map("to_start") @db.Timestamptz(6)
  toEnd         DateTime?      @map("to_end") @db.Timestamptz(6)
  timeBlockId   String?        @map("time_block_id") @db.Uuid

  owner       Profile    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromProject Project?   @relation("TaskEventFromProject", fields: [fromProjectId], references: [id], onDelete: NoAction)
  toProject   Project?   @relation("TaskEventToProject", fields: [toProjectId], references: [id], onDelete: NoAction)
  timeBlock   TimeBlock? @relation(fields: [timeBlockId], references: [id], onDelete: SetNull)

  @@index([taskId, occurredAt])
  @@index([ownerId, type, occurredAt])
  @@map("task_events")
}

enum ReviewKind {
  daily
  weekly

  @@map("review_kind")
}

enum ReviewStatus {
  open
  closed

  @@map("review_status")
}

/// What the user decided to do with a pending task at review time. `carry_over` plans it for `targetDate`; `reschedule` moves its
/// due date to `targetDate`; `drop` cancels it; `keep` leaves it as it is.
enum ReviewDecisionAction {
  carry_over
  reschedule
  drop
  keep

  @@map("review_decision_action")
}

/// Daily or weekly reflection. The period is a range of local dates (daily: one date; weekly: Monday..Sunday). While `open` the figures
/// are computed live from real data (nothing is stored); `close` snapshots them in the typed counters so the review keeps meaning
/// even if tasks change later. `reflection` and `nextFocus` are plain text. CHECKs in the migration.
model Review {
  id             String       @id @default(uuid(4)) @db.Uuid
  ownerId        String       @map("owner_id") @db.Uuid
  kind           ReviewKind
  periodStart    DateTime     @map("period_start") @db.Date
  periodEnd      DateTime     @map("period_end") @db.Date
  status         ReviewStatus @default(open)
  reflection     String?      @db.Text
  nextFocus      String?      @map("next_focus") @db.Text
  plannedTasks   Int?         @map("planned_tasks")
  completedTasks Int?         @map("completed_tasks")
  plannedMinutes Int?         @map("planned_minutes")
  actualMinutes  Int?         @map("actual_minutes")
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  decisions ReviewDecision[]

  @@unique([ownerId, kind, periodStart])
  @@index([ownerId, status, periodStart])
  @@map("reviews")
}

/// A decision taken in a review and already applied to the task (a `reschedule` or `drop` also wrote task history events).
/// One per task per review.
model ReviewDecision {
  id         String               @id @default(uuid(4)) @db.Uuid
  ownerId    String               @map("owner_id") @db.Uuid
  reviewId   String               @map("review_id") @db.Uuid
  taskId     String               @map("task_id") @db.Uuid
  action     ReviewDecisionAction
  targetDate DateTime?            @map("target_date") @db.Date
  decidedAt  DateTime             @default(now()) @map("decided_at") @db.Timestamptz(6)

  owner  Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  review Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([reviewId, taskId])
  @@index([taskId])
  @@map("review_decisions")
}

/// Repeats a task on a calendar-day schedule. `rule` is an RFC 5545 RRULE string without DTSTART (`startDate` is the DTSTART),
/// stored as opaque text and expanded by the `rrule` library. The template fields are copied into every occurrence, which is
/// a normal Task (own status and history); changing the rule never touches past or finished occurrences.
/// `generatedUntil` is the last day already examined, so an occurrence the user deleted is never re-created.
/// `startMinute` + `durationMinutes` (both or none, enforced by a CHECK) put a planned TimeBlock on each occurrence at that local
/// wall-clock time in the user's timezone ("every day at 9 am"); the Task itself stays date-only.
model RecurrenceRule {
  id               String       @id @default(uuid(4)) @db.Uuid
  ownerId          String       @map("owner_id") @db.Uuid
  rule             String       @db.VarChar(500)
  startDate        DateTime     @map("start_date") @db.Date
  generatedUntil   DateTime?    @map("generated_until") @db.Date
  startMinute      Int?         @map("start_minute")
  durationMinutes  Int?         @map("duration_minutes")
  title            String       @db.VarChar(200)
  description      String?      @db.Text
  priority         TaskPriority @default(medium)
  estimatedMinutes Int?         @map("estimated_minutes")
  projectId        String?      @map("project_id") @db.Uuid
  goalId           String?      @map("goal_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner       Profile             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project     Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal        Goal?               @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tags        RecurrenceRuleTag[]
  occurrences Task[]

  @@index([ownerId, createdAt])
  @@index([projectId])
  @@index([goalId])
  @@map("recurrence_rules")
}

model RecurrenceRuleTag {
  recurrenceRuleId String @map("recurrence_rule_id") @db.Uuid
  tagId            String @map("tag_id") @db.Uuid

  recurrenceRule RecurrenceRule @relation(fields: [recurrenceRuleId], references: [id], onDelete: Cascade)
  tag            Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recurrenceRuleId, tagId])
  @@index([tagId])
  @@map("recurrence_rule_tags")
}

/// A previous version of a note: the title and body it had right before an edit changed them (the current version lives in `notes`).
/// Written by the notes service in the same transaction as the edit, one per change; only the latest 50 per note are kept.
/// Revisions are immutable; restoring one is a normal edit, so it creates a new revision of what it replaces.
model NoteRevision {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  noteId    String   @map("note_id") @db.Uuid
  title     String   @db.VarChar(200)
  body      String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  note  Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([ownerId, noteId, createdAt])
  @@map("note_revisions")
}

enum TemplateKind {
  task
  project

  @@map("template_kind")
}

/// Reusable structure that is copied into real data on demand (nothing links back to it afterwards).
/// `task`: exactly one top-level item (the task) whose children are its subtasks.
/// `project`: `title`/`description`/tags describe the project and the top-level items are its tasks (children = subtasks).
/// Items are at most two levels deep, like tasks. CHECKs in the migration: a project template has a title, a task template has no
/// project fields, and offsets are 0..3650 days.
model Template {
  id          String       @id @default(uuid(4)) @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  kind        TemplateKind
  name        String       @db.VarChar(100)
  title       String?      @db.VarChar(200)
  description String?      @db.Text
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  tags  TemplateTag[]
  items TemplateItem[]

  @@index([ownerId, kind, createdAt])
  @@map("templates")
}

/// Tags of the project a `project` template creates.
model TemplateTag {
  templateId String @map("template_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@index([tagId])
  @@map("template_tags")
}

/// A task (top-level) or subtask (`parentId`) of a template. `dueOffsetDays` is days after the start date given when instantiating.
model TemplateItem {
  id               String       @id @default(uuid(4)) @db.Uuid
  ownerId          String       @map("owner_id") @db.Uuid
  templateId       String       @map("template_id") @db.Uuid
  parentId         String?      @map("parent_id") @db.Uuid
  position         Int
  title            String       @db.VarChar(200)
  description      String?      @db.Text
  priority         TaskPriority @default(medium)
  estimatedMinutes Int?         @map("estimated_minutes")
  dueOffsetDays    Int?         @map("due_offset_days")

  owner    Profile           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  template Template          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent   TemplateItem?     @relation("TemplateSubitems", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks TemplateItem[]    @relation("TemplateSubitems")
  tags     TemplateItemTag[]

  @@index([templateId, position])
  @@index([parentId])
  @@map("template_items")
}

model TemplateItemTag {
  itemId String @map("item_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  item TemplateItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("template_item_tags")
}

enum ReminderStatus {
  pending
  sent
  dismissed
}

/// A fire time attached to exactly one task, calendar event or note (CHECK in the migration). Not a deadline: it never reads or
/// changes a task's due date. `pending` reminders whose `remindAt` has passed are claimed by the processor (`pending -> sent`,
/// one conditional update per reminder, so overlapping runs never deliver twice). Snoozing moves `remindAt` forward and returns
/// the reminder to `pending`. Deleting the target deletes its reminders.
model Reminder {
  id              String         @id @default(uuid(4)) @db.Uuid
  ownerId         String         @map("owner_id") @db.Uuid
  taskId          String?        @map("task_id") @db.Uuid
  calendarEventId String?        @map("calendar_event_id") @db.Uuid
  noteId          String?        @map("note_id") @db.Uuid
  remindAt        DateTime       @map("remind_at") @db.Timestamptz(6)
  status          ReminderStatus @default(pending)
  snoozeCount     Int            @default(0) @map("snooze_count")
  sentAt          DateTime?      @map("sent_at") @db.Timestamptz(6)
  dismissedAt     DateTime?      @map("dismissed_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner         Profile        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  note          Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, remindAt])
  @@index([status, remindAt])
  @@index([taskId])
  @@index([calendarEventId])
  @@index([noteId])
  @@map("reminders")
}
