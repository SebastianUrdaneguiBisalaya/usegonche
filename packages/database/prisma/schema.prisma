generator client {
  provider   = "prisma-client"
  output     = "../src/generated/node"
  engineType = "client"
  runtime    = "nodejs"
}

// Same models, compiled for Cloudflare Workers (wasm module import instead of base64).
generator client_workerd {
  provider   = "prisma-client"
  output     = "../src/generated/workerd"
  engineType = "client"
  runtime    = "workerd"
}

datasource db {
  provider = "postgresql"
}

// Conventions (see AGENTS.md > Database & migrations):
// - Ids are UUID v4: `@db.Uuid @default(uuid(4))`. Only `Profile.id` is supplied by Supabase (mirrors `auth.users.id`).
// - Every user-owned table has `ownerId` (column `owner_id`) -> `Profile.id`.
// - No Json columns. Rich text is stored as `text`.
// - Timestamps are `timestamptz`.

/// App-level profile and the owner of every resource. The identity itself lives in
/// Supabase `auth.users`; `id` mirrors `auth.users.id` (also a UUID v4).
model Profile {
  id          String   @id @db.Uuid
  email       String?  @db.VarChar(255)
  avatarUrl   String?  @map("avatar_url")
  displayName String?  @map("display_name") @db.VarChar(100)
  phoneNumber String?  @map("phone_number") @db.VarChar(100)
  websiteUrl  String?  @map("website_url") @db.VarChar(255)
  bio         String?  @db.Text
  jobTitle    String?  @map("job_title") @db.VarChar(100)
  industry    String?  @db.VarChar(100)
  company     String?  @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings     UserSettings?
  tags         Tag[]
  inboxItems   InboxItem[]
  goals        Goal[]
  projects     Project[]
  tasks        Task[]
  taskBlockers TaskBlocker[]

  @@map("profiles")
}

/// One row per profile (1:1).
model UserSettings {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @unique @map("owner_id") @db.Uuid
  language  String?  @db.VarChar(10)
  theme     String?  @db.VarChar(10)
  /// IANA time zone name, e.g. `America/Lima`.
  timezone  String?  @db.VarChar(64)
  country   String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// Owner-scoped label. Names are unique per owner ignoring case via a manual-SQL index on `(owner_id, lower(name))`
/// (see the add_tags migration); `@@unique` below only models the exact-match part.
/// Links to tasks, projects and notes use typed join tables (added with those features),
/// with `onDelete: Cascade` on the tag side so deleting a tag removes its links, never the targets.
model Tag {
  id        String   @id @default(uuid(4)) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Profile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects ProjectTag[]
  tasks    TaskTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

/// Where a captured item came from. Extend (share, integration, ...) when those sources exist.
enum InboxSource {
  quick
  braindump

  @@map("inbox_source")
}

/// `converted` is terminal: the item was turned into a task, project or note (the target keeps `origin_inbox_item_id`).
enum InboxStatus {
  pending
  converted
  archived
  discarded

  @@map("inbox_status")
}

/// Raw capture, never deleted: it is only converted, archived or discarded, so nothing is lost while classifying.
model InboxItem {
  id          String      @id @default(uuid(4)) @db.Uuid
  ownerId     String      @map("owner_id") @db.Uuid
  content     String      @db.Text
  source      InboxSource @default(quick)
  status      InboxStatus @default(pending)
  capturedAt  DateTime    @default(now()) @map("captured_at") @db.Timestamptz(6)
  /// Set when the item leaves `pending`; null again when restored.
  processedAt DateTime?   @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks    Task[]

  @@index([ownerId, status, capturedAt])
  @@map("inbox_items")
}

enum GoalStatus {
  active
  achieved

  @@map("goal_status")
}

/// Lifecycle status only. Being archived is separate (`archivedAt`), so an achieved goal can be archived and an archived one restored.
enum ProjectStatus {
  active
  on_hold
  completed

  @@map("project_status")
}

/// Outcome the user wants to reach; groups projects (1:N). Never deleted, only archived.
/// `description` is serialized TipTap JSON (opaque text, validated and bounded by the API).
model Goal {
  id          String     @id @default(uuid(4)) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  title       String     @db.VarChar(200)
  description String?    @db.Text
  status      GoalStatus @default(active)
  targetDate  DateTime?  @map("target_date") @db.Date
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    Profile   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks    Task[]

  @@index([ownerId, archivedAt, createdAt])
  @@map("goals")
}

/// Container of tasks, optionally under a goal. Archiving it keeps its tasks. Never deleted, only archived.
/// `originInboxItemId` is set when it was created by converting an inbox item (an item converts at most once).
model Project {
  id                String        @id @default(uuid(4)) @db.Uuid
  ownerId           String        @map("owner_id") @db.Uuid
  goalId            String?       @map("goal_id") @db.Uuid
  originInboxItemId String?       @unique @map("origin_inbox_item_id") @db.Uuid
  title             String        @db.VarChar(200)
  description       String?       @db.Text
  status            ProjectStatus @default(active)
  archivedAt        DateTime?     @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  goal            Goal?        @relation(fields: [goalId], references: [id], onDelete: SetNull)
  originInboxItem InboxItem?   @relation(fields: [originInboxItemId], references: [id], onDelete: SetNull)
  tags            ProjectTag[]
  tasks           Task[]

  @@index([ownerId, archivedAt, createdAt])
  @@index([goalId])
  @@map("projects")
}

/// Typed join project <-> tag. The owner is implied by the project (the service checks both belong to the same owner).
/// Deleting either side removes the link only.
model ProjectTag {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("project_tags")
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled

  @@map("task_status")
}

enum TaskPriority {
  low
  medium
  high
  urgent

  @@map("task_priority")
}

/// How the task came to exist. Extend (integration, ai, ...) when those sources exist.
enum TaskOrigin {
  manual
  inbox

  @@map("task_origin")
}

/// Unit of work. Keeps lifecycle concepts apart: `status`, `priority`, dates (`startDate`/`dueDate` are the user's own
/// deadlines, not planning), derived progress (from subtasks) and derived blocking (dependencies + open blockers) are never stored.
/// Planning (when to work on it) lives in the daily plan / time blocks, not here.
/// `completedAt` is set when the status becomes `done` and cleared when reopened. Subtasks are single level (`parentId`).
/// `description` is serialized TipTap JSON (opaque text).
model Task {
  id                String       @id @default(uuid(4)) @db.Uuid
  ownerId           String       @map("owner_id") @db.Uuid
  parentId          String?      @map("parent_id") @db.Uuid
  projectId         String?      @map("project_id") @db.Uuid
  goalId            String?      @map("goal_id") @db.Uuid
  originInboxItemId String?      @unique @map("origin_inbox_item_id") @db.Uuid
  title             String       @db.VarChar(200)
  description       String?      @db.Text
  status            TaskStatus   @default(todo)
  priority          TaskPriority @default(medium)
  origin            TaskOrigin   @default(manual)
  startDate         DateTime?    @map("start_date") @db.Date
  dueDate           DateTime?    @map("due_date") @db.Date
  estimatedMinutes  Int?         @map("estimated_minutes")
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           Profile          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parent          Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks        Task[]           @relation("Subtasks")
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  goal            Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  originInboxItem InboxItem?       @relation(fields: [originInboxItemId], references: [id], onDelete: SetNull)
  tags            TaskTag[]
  /// Tasks this one waits for.
  dependencies    TaskDependency[] @relation("Dependent")
  /// Tasks waiting for this one.
  dependents      TaskDependency[] @relation("Dependency")
  blockers        TaskBlocker[]

  @@index([ownerId, status, createdAt])
  @@index([ownerId, dueDate])
  @@index([parentId])
  @@index([projectId])
  @@index([goalId])
  @@map("tasks")
}

/// `taskId` waits for `dependsOnId`. No self-dependency (CHECK in the migration) and no cycles (checked by the service).
/// The owner is implied by the tasks (the service checks both belong to the same owner).
model TaskDependency {
  taskId      String @map("task_id") @db.Uuid
  dependsOnId String @map("depends_on_id") @db.Uuid

  task      Task @relation("Dependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("Dependency", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@index([dependsOnId])
  @@map("task_dependencies")
}

/// Manual impediment with a reason. Kept after it is resolved (`resolvedAt`) so recurring blockers can be analyzed.
model TaskBlocker {
  id         String    @id @default(uuid(4)) @db.Uuid
  ownerId    String    @map("owner_id") @db.Uuid
  taskId     String    @map("task_id") @db.Uuid
  reason     String    @db.VarChar(500)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner Profile @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  task  Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, resolvedAt])
  @@index([ownerId, startedAt])
  @@map("task_blockers")
}

/// Typed join task <-> tag. Deleting either side removes the link only.
model TaskTag {
  taskId String @map("task_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}
