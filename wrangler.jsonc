{
	"$schema": "node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/worker.ts",
	"name": "usegonche-api",
	"observability": { "enabled": true },
	// Rate limiting (src/middleware/rate-limit.ts). Cloudflare Rate Limiting bindings: `period` can only be 10 or 60 seconds.
	// Without them the middleware falls back to per-isolate memory counters, which are NOT a real limit on Workers.
	"ratelimits": [
		{ "name": "RATE_LIMIT_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
		{ "name": "RATE_LIMIT_USER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
		{ "name": "RATE_LIMIT_AUTH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
	]
	// Secrets (never commit): `wrangler secret put DATABASE_URL`, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY.
	// Local dev reads them from .dev.vars.
	// Optional Hyperdrive (recommended with Supabase pooler on Workers):
	// "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }]
}
